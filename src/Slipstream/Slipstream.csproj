<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<PackageId>Slipstream</PackageId>
	<Version>0.0.5</Version>
	<Authors>Tim Taylor</Authors>
	<Description>A lightweight, fast MediatR alternative focused on request/response dispatching with pipeline behavior support.</Description>
	<PackageTags>dispatcher;pipeline;cqrs;mediator</PackageTags>
	<PackageProjectUrl>https://github.com/xthrush/Slipstream</PackageProjectUrl>
	<RepositoryUrl>https://github.com/xthrush/Slipstream</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <TargetFrameworks>net8.0;net6.0;netstandard2.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Behaviors\" />
  </ItemGroup>

  <ItemGroup>
	<None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
