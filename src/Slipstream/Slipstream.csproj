<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<PackageId>Slipstream</PackageId>
	<Version>0.0.1</Version>
	<Authors>Tim Taylor</Authors>
	<Description>A lightweight, fast MediatR alternative focused on request/response dispatching with pipeline behavior support.</Description>
	<PackageTags>mediatr;dispatcher;pipeline;cqrs;mediator</PackageTags>
	<PackageProjectUrl>https://github.com/yourusername/yourrepo</PackageProjectUrl>
	<RepositoryUrl>https://github.com/yourusername/yourrepo</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  
	  
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Behaviors\" />
  </ItemGroup>

</Project>
